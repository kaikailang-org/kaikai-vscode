{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "kaikai",
  "scopeName": "source.kaikai",
  "fileTypes": [
    "kai"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#regex"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#visibility"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#effects"
    },
    {
      "include": "#constructors"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#holes"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.kaikai",
          "match": "#(?!\\[).*$",
          "captures": {
            "0": {
              "patterns": [
                {
                  "name": "keyword.codetag.kaikai",
                  "match": "\\b(TODO|FIXME|XXX|NOTE|HACK)\\b"
                }
              ]
            }
          }
        }
      ]
    },
    "attributes": {
      "name": "meta.attribute.kaikai",
      "begin": "(#\\[)\\s*([a-z_][A-Za-z0-9_]*)?",
      "end": "\\]",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.attribute.begin.kaikai"
        },
        "2": {
          "name": "entity.name.function.attribute.kaikai"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.end.kaikai"
        }
      },
      "patterns": [
        {
          "include": "#attribute-brackets"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#constructors"
        },
        {
          "include": "#operators"
        }
      ]
    },
    "attribute-brackets": {
      "begin": "\\[",
      "end": "\\]",
      "patterns": [
        {
          "include": "#attribute-brackets"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#constructors"
        },
        {
          "include": "#operators"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kaikai",
          "match": "\\b(if|else|match|case|when|for|with|handle|where|requires|ensures)\\b"
        },
        {
          "name": "keyword.other.lazy.kaikai",
          "match": "\\blazy\\b"
        },
        {
          "name": "storage.type.kaikai",
          "match": "\\b(fn|let|var|const|type|effect|protocol|impl|import|use|test|bench|check|extern|axiom|theory|unit)\\b"
        },
        {
          "name": "storage.modifier.kaikai",
          "match": "\\b(pub|priv|as|assert)\\b"
        },
        {
          "name": "keyword.operator.logical.kaikai",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.boolean.kaikai",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "invalid.deprecated.todo.kaikai",
          "match": "\\btodo!"
        }
      ]
    },
    "visibility": {
      "match": "\\b(pub)(\\()\\s*(pkg)\\s*(\\))",
      "captures": {
        "1": {
          "name": "storage.modifier.kaikai"
        },
        "2": {
          "name": "punctuation.section.parens.begin.kaikai"
        },
        "3": {
          "name": "storage.modifier.kaikai"
        },
        "4": {
          "name": "punctuation.section.parens.end.kaikai"
        }
      }
    },
    "types": {
      "name": "support.type.builtin.kaikai",
      "match": "\\b(Int|Real|Bool|String|Char|Unit|Nothing|Option|Result|List|Pair|Map|Set|Seq|Stack|Queue|Array|Bytes|Decimal|BigInt|Complex|Int32|Int128|UInt32|UInt64|Money|Fiber|Pid|Regex|Match|Capture|WallTime|Instant|Duration)\\b"
    },
    "effects": {
      "name": "support.class.effect.kaikai",
      "match": "\\b(Console|Stdin|Stdout|Stderr|File|Env|State|Reader|Writer|Actor|Spawn|Link|Monitor|Cancel|Mutable|Fail|Random|SecureRandom|Time|Clock|Ffi|Log|Trace|Process|Signal|Yield|NetTcp|NetUdp|NetUnix|NetDns)\\b"
    },
    "constructors": {
      "name": "entity.name.type.kaikai",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.kaikai"
            },
            "2": {
              "name": "entity.name.function.kaikai"
            }
          }
        },
        {
          "match": "\\b(type|effect|protocol|impl|kind|opaque)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.kaikai"
            },
            "2": {
              "name": "entity.name.type.kaikai"
            }
          }
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.kaikai",
      "match": "\\b(0[xX][0-9a-fA-F]+|0[bB][01]+|\\d[0-9_]*(\\.\\d[0-9_]*)?([eE][+-]?\\d+)?)i?\\b"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.kaikai",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#string-escapes"
            },
            {
              "include": "#string-interp"
            }
          ]
        },
        {
          "name": "string.quoted.double.kaikai",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#string-escapes"
            },
            {
              "include": "#string-interp"
            }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.kaikai",
          "match": "\\\\([\\\\\"'nrt0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
        },
        {
          "name": "invalid.illegal.escape.kaikai",
          "match": "\\\\."
        }
      ]
    },
    "string-interp": {
      "name": "meta.embedded.expression.kaikai",
      "begin": "#\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.kaikai"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.kaikai"
        }
      },
      "patterns": [
        {
          "include": "#interp-format"
        },
        {
          "include": "#interp-braces"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#visibility"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#effects"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#constructors"
        },
        {
          "include": "#holes"
        }
      ]
    },
    "interp-format": {
      "match": "(:)([<>^]?[0-9]*(?:\\.[0-9]+)?)(?=\\})",
      "captures": {
        "1": {
          "name": "punctuation.separator.format.kaikai"
        },
        "2": {
          "name": "constant.other.format-spec.kaikai"
        }
      }
    },
    "interp-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#interp-braces"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#visibility"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#effects"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#constructors"
        },
        {
          "include": "#holes"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.kaikai",
      "match": "'(\\\\(u\\{[0-9a-fA-F]+\\}|.)|[^\\\\'])'"
    },
    "regex": {
      "name": "string.regexp.kaikai",
      "match": "~r/(?:\\\\.|[^/\\\\])*/[a-z]*"
    },
    "holes": {
      "name": "variable.language.hole.kaikai",
      "match": "\\?[a-zA-Z_][a-zA-Z0-9_]*|\\?"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.kaikai",
          "match": "\\|>|\\|\\||\\|\\?|\\|!|\\|"
        },
        {
          "name": "keyword.operator.coalesce.kaikai",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.arrow.kaikai",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.comparison.kaikai",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.kaikai",
          "match": ":=|="
        },
        {
          "name": "keyword.operator.concat.kaikai",
          "match": "\\+\\+"
        },
        {
          "name": "keyword.operator.range.kaikai",
          "match": "\\.\\.\\.|\\.\\."
        },
        {
          "name": "keyword.operator.arithmetic.kaikai",
          "match": "[+\\-*/%^]"
        },
        {
          "name": "keyword.operator.other.kaikai",
          "match": "[!@:&$]"
        }
      ]
    }
  }
}
