{
  "fn (single-line)": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:args}) : ${3:Unit} = ${4:expr}"
    ],
    "description": "Single-expression function definition."
  },
  "fn (block body)": {
    "prefix": "fnblock",
    "body": [
      "fn ${1:name}(${2:args}) : ${3:Unit} = {",
      "  $0",
      "}"
    ],
    "description": "Block-body function definition."
  },
  "pub fn": {
    "prefix": "pubfn",
    "body": [
      "pub fn ${1:name}(${2:args}) : ${3:Unit} = {",
      "  $0",
      "}"
    ],
    "description": "Public block-body function."
  },
  "match expression": {
    "prefix": "match",
    "body": [
      "match ${1:expr} {",
      "  ${2:pattern} -> ${3:result}",
      "  _ -> $0",
      "}"
    ],
    "description": "Match expression."
  },
  "sum type": {
    "prefix": "type_sum",
    "body": [
      "type ${1:Name} =",
      "  | ${2:Variant1}",
      "  | ${3:Variant2}$0"
    ],
    "description": "Sum type with variants."
  },
  "record type": {
    "prefix": "type_record",
    "body": [
      "type ${1:Name} = { ${2:field}: ${3:Type}$0 }"
    ],
    "description": "Record type."
  },
  "effect declaration": {
    "prefix": "effect",
    "body": [
      "effect ${1:Name} {",
      "  ${2:op}(${3:args}) : ${4:ReturnType}$0",
      "}"
    ],
    "description": "Effect declaration."
  },
  "protocol declaration": {
    "prefix": "protocol",
    "body": [
      "protocol ${1:Name} {",
      "  ${2:method}(${3:self: Self}) : ${4:ReturnType}$0",
      "}"
    ],
    "description": "Protocol declaration."
  },
  "impl block": {
    "prefix": "impl",
    "body": [
      "impl ${1:Protocol} for ${2:Type} {",
      "  $0",
      "}"
    ],
    "description": "Protocol implementation."
  },
  "handle expression": {
    "prefix": "handle",
    "body": [
      "handle {",
      "  ${1:body}",
      "} with ${2:Effect} {",
      "  ${3:op}(resume) -> $0",
      "}"
    ],
    "description": "Handle/with expression for algebraic effects."
  },
  "test block": {
    "prefix": "test",
    "body": [
      "test \"${1:description}\" {",
      "  $0",
      "}"
    ],
    "description": "Test declaration."
  },
  "import": {
    "prefix": "import",
    "body": [
      "import ${1:module}$0"
    ],
    "description": "Module import."
  },
  "lambda": {
    "prefix": "lambda",
    "body": [
      "fn(${1:x}) -> $0"
    ],
    "description": "Anonymous function."
  }
}
